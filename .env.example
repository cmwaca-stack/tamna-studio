# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요. (Windows: copy .env.example .env.local)
# 값에는 따옴표·공백·# 주석을 붙이지 마세요. 저장 후 실행 중인 서버를 껐다 켭니다.

# ── 브라우저에 들어가는 값 (VITE_ 로 시작) : Supabase 의 공개용 anon 키만! ──
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── 서버(/api)에서만 쓰는 비밀 값 : 절대 VITE_ 를 붙이지 마세요 ──
DATA_GO_KR_KEY=
ANTHROPIC_API_KEY=
# 실시간 교통(CCTV): its.go.kr 오픈API 인증키. 비워 두면 공개 데모 키로 시도합니다.
ITS_API_KEY=
# 제주 생활방언(B02) 요청키 — 제주도청에서 발급. 방언사전·속담사전은 키 없이 동작합니다.
JEJU_API_KEY=
